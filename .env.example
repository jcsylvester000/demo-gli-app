# Copy to .env.local (never commit .env.local)
DATABASE_URL=postgresql://USER:PASSWORD@HOST-pooler.REGION.aws.neon.tech/neondb?sslmode=require&channel_binding=require
IP_HASH_SALT=change-me-to-a-long-random-string
# Optional
NEXT_PUBLIC_GTM_ID=
NEXT_PUBLIC_SITE_URL=http://localhost:3000
ALLOW_INDEXING=false
# Lead capture (Batch 4): all optional locally. Without them, leads still save; emails wait in the outbox.
RESEND_API_KEY=
LEAD_FROM_EMAIL=
SALES_INBOX=
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
CRON_SECRET=
TEAM_ALERT_WEBHOOK_URL=
