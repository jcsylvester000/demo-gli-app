# Copy to .env.local (never commit .env.local)
DATABASE_URL=postgresql://USER:PASSWORD@HOST-pooler.REGION.aws.neon.tech/neondb?sslmode=require&channel_binding=require
IP_HASH_SALT=change-me-to-a-long-random-string
# Optional
NEXT_PUBLIC_GTM_ID=
NEXT_PUBLIC_SITE_URL=http://localhost:3000
ALLOW_INDEXING=false
# Spam check on forms (optional locally; Cloudflare test keys are used until set). Forms store leads only: no email settings.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
# Admin (Batch 5)
BETTER_AUTH_SECRET=replace-with-32-plus-random-characters
BETTER_AUTH_URL=http://localhost:3000
